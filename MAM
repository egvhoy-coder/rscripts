local function cleanMapCrystals()
    local count = 0
    local crystalsFolder = Workspace:FindFirstChild("Things") and Workspace.Things:FindFirstChild("Crystals")
    if crystalsFolder then
        for _, v in pairs(crystalsFolder:GetDescendants()) do
            if v:IsA("BasePart") and v.Name:find("Crystal_T") then
                v:Destroy()
                count = count + 1
            end
        end
    end
    return count
end

