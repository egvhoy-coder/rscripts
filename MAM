local function getDigPosition()
    local cam = Workspace.CurrentCamera
    local hrp = humanoidRootPart
    if not (cam and hrp) then return nil end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    local filter = {Workspace.Terrain}
    params.FilterDescendantsInstances = filter
    
    local reach = 54
    local result = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * reach, params)
    if result then return result.Position end
    
    result = Workspace:Raycast(hrp.Position, cam.CFrame.LookVector * reach, params)
    if result then return result.Position end
    
    return nil
end

