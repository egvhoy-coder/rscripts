-- BOULDER CONTROL FUNCTIONS
-- ============================================================
local boulderTargetPos = Vector3.new(33, 43, 922)

local function moveUnanchoredBoulders()
    local bouldersRoot = Workspace:FindFirstChild("MountainDecorations")
    if bouldersRoot then bouldersRoot = bouldersRoot:FindFirstChild("Boulders") end
    if not bouldersRoot then return 0 end
    
    local count = 0
    for _, desc in pairs(bouldersRoot:GetDescendants()) do
        if desc:IsA("BasePart") and not desc.Anchored then
            desc.CFrame = CFrame.new(boulderTargetPos)
            count = count + 1
        end
    end
    return count
end

-- FIXED: Get anchored boulders filtered by name
local function getAnchoredBoulders()
    local bouldersRoot = Workspace:FindFirstChild("MountainDecorations")
    if bouldersRoot then bouldersRoot = bouldersRoot:FindFirstChild("Boulders") end
    if not bouldersRoot then return {} end
    
    local anchored = {}
    for _, desc in pairs(bouldersRoot:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Anchored then
            table.insert(anchored, desc)
        end
    end
    return anchored
end

-- NEW: Get closest anchored boulder by specific type
local function getClosestBoulderByType(boulderType)
    local bouldersRoot = Workspace:FindFirstChild("MountainDecorations")
    if bouldersRoot then bouldersRoot = bouldersRoot:FindFirstChild("Boulders") end
    if not bouldersRoot then return nil end
    
    local char = player.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local closest = nil
    local minDist = math.huge
    
    for _, desc in pairs(bouldersRoot:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Anchored then
            -- Check if boulder name contains the type (case-insensitive)
            if desc.Name:lower():find(boulderType:lower()) then
                local dist = (rootPart.Position - desc.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = desc
                end
            end
        end
    end
    
    return closest
end

local function tpToBoulder(boulderPart)
    local char = player.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart or not boulderPart then return false end
    
    rootPart.CFrame = boulderPart.CFrame * CFrame.new(0, 5, 0)
    
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        local bomb = backpack:FindFirstChild("Classic Bomb")
        if bomb and bomb:IsA("Tool") then
            bomb.Parent = char
        end
    end
    return true
end

