-- ============================================================
-- DE-GLOW
-- ============================================================
local function deGlow(crystal)
    if crystal:IsA("BasePart") and (crystal.Name:find("Crystal_T") or crystal.Name:find("DroppedCrystal_T")) then
        crystal.Material = Enum.Material.SmoothPlastic
        for _, child in pairs(crystal:GetChildren()) do
            if child:IsA("PointLight") or child:IsA("ParticleEmitter") or child:IsA("SurfaceLight") or child:IsA("SpotLight") then
                child:Destroy()
            end
        end
    end
end

local function setupCrystalWatcher()
    local things = Workspace:FindFirstChild("Things")
    local crystalsFolder = things and things:FindFirstChild("Crystals")
    local droppedFolder = Workspace:FindFirstChild("DroppedCrystals")

    if crystalsFolder then
        for _, v in pairs(crystalsFolder:GetDescendants()) do deGlow(v) end
        local conn = crystalsFolder.ChildAdded:Connect(function(child)
            if not scriptActive then return end
            task.wait() 
            deGlow(child)
            for _, desc in pairs(child:GetDescendants()) do deGlow(desc) end
        end)
        table.insert(allConnections, conn)
    end

    if droppedFolder then
        for _, v in pairs(droppedFolder:GetDescendants()) do deGlow(v) end
        local conn = droppedFolder.ChildAdded:Connect(function(child)
            if not scriptActive then return end
            task.wait() 
            deGlow(child)
            for _, desc in pairs(child:GetDescendants()) do deGlow(desc) end
        end)
        table.insert(allConnections, conn)
    end
end

setupCrystalWatcher()

-- ============================================================
-- HAZARD REMOVER
-- ============================================================
local hazardNukeActive = true

local function nukeHazards()
    if not scriptActive then return end
    
    local md = Workspace:FindFirstChild("MountainDecorations")
    local avalanche = Workspace:FindFirstChild("Avalanche")
    local things = Workspace:FindFirstChild("Things")
    local lavaFolder = things and things:FindFirstChild("Lava")
    
    if lavaFolder then
        pcall(function() lavaFolder:Destroy() end)
    end
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = v.Name:lower()
            local isLava = (n == "lava" or n:find("lava"))
            local isRock = (v.Name == "Rock" and md and v:IsDescendantOf(md))
            local isAvalanche = (v.Name == "AvalanchePart" and avalanche and v:IsDescendantOf(avalanche))
            
            if isLava then
                pcall(function() v:Destroy() end)
            elseif isRock or isAvalanche then
                pcall(function()
                    v.CanCollide = false
                    v.CanTouch = false
                    v.CanQuery = false
                    v.Transparency = 0.7
                    v.Anchored = true
                    v.Velocity = Vector3.new(0, 0, 0)
                    v.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end
    end
end

task.spawn(function()
    while scriptActive do
        if hazardNukeActive then nukeHazards() end
        task.wait(1) -- Changed from 0.5 to 1 to reduce lag
    end
end)

nukeHazards()

