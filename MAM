local function updateVisuals()
    if not scriptActive then return end
    
    local xrayOn = toggles["Crystal X-Ray (T4/T5/T6)"].state
    
    if not xrayOn then
        for _, folder in ipairs(getCrystalFolders()) do
            for _, crystal in ipairs(folder:GetChildren()) do
                local hl = crystal:FindFirstChild("Highlight")
                if hl then hl:Destroy() end
            end
        end
        return
    end

    for _, folder in ipairs(getCrystalFolders()) do
        for _, crystal in ipairs(folder:GetChildren()) do
            if crystal:IsA("BasePart") then
                local tier = tonumber(crystal.Name:match("T(%d+)"))
                local targetColor = nil
                if tier then
                    if tier >= 4 then
                        if tier == 6 then targetColor = Color3.fromRGB(100, 255, 255)
                        elseif tier == 5 then targetColor = Color3.fromRGB(255, 100, 255)
                        elseif tier == 4 then targetColor = Color3.fromRGB(255, 255, 100)
                        end
                    end
                end
                
                local hl = crystal:FindFirstChild("Highlight")
                if targetColor then
                    if hl then
                        if hl.FillColor ~= targetColor then hl.FillColor = targetColor; hl.OutlineColor = targetColor end
                    else
                        hl = Instance.new("Highlight")
                        hl.Name = "Highlight"
                        hl.FillColor = targetColor; hl.FillTransparency = 0.7
                        hl.OutlineColor = targetColor; hl.OutlineTransparency = 0.3
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = crystal
                    end
                else
                    if hl then hl:Destroy() end
                end
            end
        end
    end
end

local function getAllBoulders()
    local boulders = {}
    
    local bouldersRoot = Workspace:FindFirstChild("MountainDecorations")
    if bouldersRoot then bouldersRoot = bouldersRoot:FindFirstChild("Boulders") end
    
    if bouldersRoot then
        for _, boulder in ipairs(bouldersRoot:GetChildren()) do
            if boulder:IsA("Model") or boulder:IsA("BasePart") then
                table.insert(boulders, boulder)
            end
        end
    end
    
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Model") or desc:IsA("BasePart") then
            if desc.Name:lower():find("boulder") and not table.find(boulders, desc) then
                table.insert(boulders, desc)
            end
        end
    end
    
    return boulders
end

local function getBoulderColor(part)
    local combined = (part.Name .. " " .. tostring(part:GetAttribute("Rarity") or part:GetAttribute("Tier") or "")):lower()
    
    if combined:find("mossite") then return Color3.fromRGB(80, 180, 80) end
    if combined:find("voidtite") or combined:find("void") then return Color3.fromRGB(120, 60, 180) end
    if combined:find("gildrite") or combined:find("gold") then return Color3.fromRGB(220, 180, 50) end
    if combined:find("rimeveil") or combined:find("ice") or combined:find("frost") then return Color3.fromRGB(100, 200, 220) end
    if combined:find("nocturnite") or combined:find("night") or combined:find("dark") then return Color3.fromRGB(60, 60, 120) end
    
    if combined:find("mythic") or combined:find("celestial") or combined:find("legendary") then return Color3.fromRGB(255, 215, 0) end
    if combined:find("diamond") or combined:find("epic") then return Color3.fromRGB(0, 255, 255) end
    if combined:find("rare") or combined:find("silver") or combined:find("iron") then return Color3.fromRGB(180, 80, 255) end
    return Color3.fromRGB(110, 30, 160) 
end

