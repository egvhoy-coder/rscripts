	Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

	local switchKnob = Instance.new("Frame")
	switchKnob.Size = UDim2.new(0, 22, 0, 22)
	switchKnob.Position = initialState and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 2, 0.5, -11)
	switchKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	switchKnob.BorderSizePixel = 0
	switchKnob.Parent = switchBg
	Instance.new("UICorner", switchKnob).CornerRadius = UDim.new(1, 0)

	local clickButton = Instance.new("TextButton")
	clickButton.Size = UDim2.new(0, 60, 0, 36)
	clickButton.Position = UDim2.new(1, -70, 0.5, -18)
	clickButton.BackgroundTransparency = 1
	clickButton.Text = ""
	clickButton.AutoButtonColor = false
	clickButton.ZIndex = 10
	clickButton.Parent = card

	toggles[name] = { card = card, switchBg = switchBg, switchKnob = switchKnob, button = clickButton, state = initialState, callbacks = {} }

	clickButton.MouseButton1Click:Connect(function()
		local newState = not toggles[name].state
		toggles[name].state = newState
		local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		if newState then
			TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = COLORS.Success}):Play()
			TweenService:Create(switchKnob, tweenInfo, {Position = UDim2.new(1, -24, 0.5, -11)}):Play()
		else
			TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(80, 80, 90)}):Play()
			TweenService:Create(switchKnob, tweenInfo, {Position = UDim2.new(0, 2, 0.5, -11)}):Play()
		end
		for _, callback in ipairs(toggles[name].callbacks) do pcall(callback, newState) end
	end)

	clickButton.MouseEnter:Connect(function() TweenService:Create(cardStroke, TweenInfo.new(0.15), {Transparency = 0, Color = COLORS.Accent}):Play() end)
	clickButton.MouseLeave:Connect(function() TweenService:Create(cardStroke, TweenInfo.new(0.15), {Transparency = 0.5, Color = COLORS.Border}):Play() end)

	return toggles[name]
end

