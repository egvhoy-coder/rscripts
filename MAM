-- CLEANER + CRYSTAL CAP
local function getTierAndMinWeight(name)
	local tier = tonumber(name:match("T(%d+)"))
	if not tier then return 0, 0 end
	
	if tier == 1 then return tier, weightThresholds.Common
	elseif tier == 2 then return tier, weightThresholds.Uncommon
	elseif tier == 3 then return tier, weightThresholds.Rare
	elseif tier == 4 then return tier, weightThresholds.Epic
	elseif tier == 5 then return tier, weightThresholds.Legendary
	elseif tier == 6 then return tier, weightThresholds.Mythic
	else return tier, 0 end
end

local function runCleaner()
    if not scriptActive then return end
    
	for _, folder in ipairs(getCrystalFolders()) do
		for _, crystal in ipairs(folder:GetChildren()) do
			if crystal:IsA("BasePart") then
				local tier, minWeight = getTierAndMinWeight(crystal.Name)
				if tier > 0 and (crystal:GetAttribute("WeightKg") or 0) < minWeight then
					crystal:Destroy(); removedCrystals += 1
				end
			end
		end
	end
	countLabel.Text = "Removed: " .. removedCrystals .. " | Kept: " .. keptHeavyCrystals
end

local CRYSTAL_CAP = 200

local function runCrystalCap()
    if not scriptActive then return end
    if not (toggles["Crystal Cap (200 Max)"] and toggles["Crystal Cap (200 Max)"].state) then return end
    
    local crystalsFolder = Workspace:FindFirstChild("Things") and Workspace.Things:FindFirstChild("Crystals")
    if not crystalsFolder then return end
    
    local crystals = {}
    for _, crystal in ipairs(crystalsFolder:GetChildren()) do
        if crystal:IsA("BasePart") and crystal.Name:find("Crystal_T") then
            local tier = tonumber(crystal.Name:match("T(%d+)")) or 0
            local weight = crystal:GetAttribute("WeightKg") or 0
            table.insert(crystals, { part = crystal, tier = tier, weight = weight })
        end
    end
    
    if #crystals > CRYSTAL_CAP then
        table.sort(crystals, function(a, b)
            if a.tier ~= b.tier then return a.tier < b.tier end
            return a.weight < b.weight
        end)
        
        local toDelete = #crystals - CRYSTAL_CAP
        for i = 1, toDelete do
            if crystals[i] and crystals[i].part and crystals[i].part.Parent then
                crystals[i].part:Destroy()
                removedCrystals += 1
            end
        end
    end
end

