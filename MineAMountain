local function updateBoulderXray(state)
    if not scriptActive then return end
    
    local bouldersRoot = getBoulderFolder()
    if not bouldersRoot then 
        statusLabel.Text = "Status: Boulders folder not found"
        statusLabel.TextColor3 = COLORS.Warning
        return 
    end
    
    for _, label in pairs(boulderLabels) do pcall(function() label:Destroy() end) end
    boulderLabels = {}

    if state then
        local count = 0
        for _, boulder in ipairs(bouldersRoot:GetChildren()) do
            applyBoulderName(boulder)
            count += 1
        end
        statusLabel.Text = ("Status: Boulder Names enabled (%d found)"):format(count)
        statusLabel.TextColor3 = COLORS.Success
        
        if not bouldersRoot:GetAttribute("XrayHooked") then
            bouldersRoot:SetAttribute("XrayHooked", true)
            local conn = bouldersRoot.ChildAdded:Connect(function(child)
                if not scriptActive then return end
                if toggles["Boulder Names (5000 Studs)"].state then
                    applyBoulderName(child)
                end
            end)
            table.insert(allConnections, conn)
        end
    else
        statusLabel.Text = "Status: Boulder Names disabled"
        statusLabel.TextColor3 = COLORS.TextDim
    end
end

